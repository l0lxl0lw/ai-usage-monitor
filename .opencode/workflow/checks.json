{
  "checks": [
    {
      "allow_skips": false,
      "argv": [
        "python3",
        "scripts/build-app.py",
        "--configuration",
        "release",
        "--output",
        "build/Relay.app"
      ],
      "cwd": ".",
      "env_keys": [
        "DEVELOPER_DIR",
        "SDKROOT",
        "TOOLCHAINS"
      ],
      "format": "exit",
      "id": "BUILD",
      "kind": "compile",
      "required": true,
      "timeout_seconds": 1800
    },
    {
      "allow_skips": false,
      "argv": [
        "python3",
        "scripts/check.py",
        "bundle",
        "build/Relay.app"
      ],
      "cwd": ".",
      "format": "script",
      "id": "BUNDLE",
      "kind": "static",
      "required": true,
      "success_pattern": "^PASS bundle$"
    },
